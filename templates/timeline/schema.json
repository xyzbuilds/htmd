{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "timeline",
  "type": "object",
  "required": ["title", "events"],
  "properties": {
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "timestamp": { "type": "string" },
          "title": { "type": "string" },
          "body": { "type": "string" },
          "actor": { "type": "string" },
          "kind": { "type": "string", "enum": ["info", "success", "warning", "error", "neutral"] }
        }
      }
    }
  }
}
