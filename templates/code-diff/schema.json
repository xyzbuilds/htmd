{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "code-diff",
  "type": "object",
  "required": ["files"],
  "properties": {
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "block_id": { "type": "string" },
    "prompt_intro": { "type": "string" },
    "allow_accept_reject": { "type": "boolean", "default": true },
    "mode": { "type": "string", "enum": ["unified", "split"] },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "language": { "type": "string" },
          "before": { "type": "string" },
          "after": { "type": "string" },
          "mode": { "type": "string", "enum": ["unified", "split"] }
        }
      }
    }
  }
}
